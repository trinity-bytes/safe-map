{
  "name": "tranqui-landing",
  "type": "module",
  "version": "1.1.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,astro,json,css,md}",
    "type-check": "astro check && tsc --noEmit",
    "postinstall": "node scripts/astro-compiler-fallback.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
