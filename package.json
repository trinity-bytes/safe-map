{
  "name": "safemap-landing",
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,astro,json,css,md}",
    "type-check": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@midudev/tailwind-animations": "^0.2.0",
    "astro": "^5.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.5.3"
  }
}
