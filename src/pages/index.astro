---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import Problem from '@/components/sections/Problem.astro';
import Manifesto from '@/components/sections/Manifesto.astro';
import Narrative from '@/components/sections/Narrative.astro';
import Privacy from '@/components/sections/Privacy.astro';
import Institutions from '@/components/sections/Institutions.astro';
import Plans from '@/components/sections/Plans.astro';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <Problem />
    <Manifesto />
    <Narrative />
    <Privacy />
    <Institutions />
    <Plans />
  </main>
  <Footer />
</BaseLayout>
