---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'SafeMap: exploración y reportes ciudadanos, con privacidad como punto de partida.' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} /><link rel="canonical" href={Astro.url} /></head><body><slot /></body></html>
