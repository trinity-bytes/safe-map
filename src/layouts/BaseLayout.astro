---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Tranqui — Llega a tu destino con más tranquilidad',
  description = 'Una app de reportes anónimos que tus vecinos validan: mira qué pasa en tu zona y elige por dónde ir. Proyecto académico en desarrollo.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={new URL(`${base}og-image.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tranqui. Llega a tu destino con más tranquilidad. Vista previa de la aplicación." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#071426" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
