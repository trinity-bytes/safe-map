---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'SafeMap — Llega a tu destino con más tranquilidad',
  description = 'Una app de reportes anónimos que tus vecinos validan: mira qué pasa en tu zona y elige por dónde ir. Proyecto académico en desarrollo.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
