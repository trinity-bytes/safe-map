---
import { Picture } from 'astro:assets';
import PhoneFrame from '../ui/PhoneFrame.astro';
import reportPhoto from '../../assets/landing/photos/narrativa-01-reporta.png';
import validationPhoto from '../../assets/landing/photos/narrativa-02-validan.png';
import alertPhoto from '../../assets/landing/photos/narrativa-03-alerta.png';
import arrivalPhoto from '../../assets/landing/photos/narrativa-04-llegas.png';
import reportScreen from '../../assets/landing/screens/02-reportar.png';
import validationScreen from '../../assets/landing/screens/03-validar.png';
import alertScreen from '../../assets/landing/screens/04-alerta.png';
import arrivalScreen from '../../assets/landing/screens/05-ruta.png';

const steps = [
  {
    label: 'Reporta', photo: reportPhoto, screen: reportScreen,
    title: 'Primero, alguien reporta lo que vio.',
    mobileTitle: 'Primero, alguien reporta lo que vio.',
    body: 'Elige qué pasó y la app toma la ubicación. Nadie ve su nombre, ni otros usuarios ni las instituciones.',
    mobileBody: 'Elige qué pasó y la app toma la ubicación. Nadie ve su nombre.',
    alt: 'Vista previa del formulario para enviar un reporte anónimo.',
  },
  {
    label: 'Validan', photo: validationPhoto, screen: validationScreen,
    title: 'Luego, los vecinos de la zona lo confirman.',
    mobileTitle: 'Luego, los vecinos lo confirman.',
    body: 'Quienes están cerca responden si lo vieron. Con cinco confirmaciones, el reporte queda validado y pinta el mapa.',
    mobileBody: 'Con cinco confirmaciones, el reporte queda validado y pinta el mapa.',
    alt: 'Vista previa de un reporte con tres de cinco confirmaciones de vecinos.',
  },
  {
    label: 'Alerta', photo: alertPhoto, screen: alertScreen,
    title: 'Entonces te llega la alerta, si estás cerca.',
    mobileTitle: 'Entonces te llega la alerta.',
    body: 'Solo recibes lo que pasa en tu zona o en tu ruta, a tiempo para decidir por dónde ir.',
    mobileBody: 'Solo recibes lo que pasa en tu zona o en tu ruta, a tiempo para decidir.',
    alt: 'Vista previa de una alerta cercana y una sugerencia de ruta alternativa.',
  },
  {
    label: 'Llegas', photo: arrivalPhoto, screen: arrivalScreen,
    title: 'Y quien tú elijas ve que llegaste bien.',
    mobileTitle: 'Y quien tú elijas ve que llegaste bien.',
    body: 'La app te propone el camino con menos reportes y puedes compartir tu recorrido en vivo mientras caminas.',
    mobileBody: 'Te propone el camino con menos reportes y puedes compartir tu recorrido en vivo.',
    alt: 'Vista previa de una ruta sugerida que se comparte con dos contactos.',
  },
];

// Circular glyphs use fixed cells so missing Unicode font glyphs cannot widen the halo.
const halo = (band: number) => {
  const width = 76;
  const height = 74;
  const radius = 6 + band * 2;
  const halfWidth = 29 + band * 3;
  const halfHeight = 31.2 + band * 2;
  return Array.from({ length: height }, (_, row) =>
    Array.from({ length: width }, (_, col) => {
      const x = Math.abs(col - (width - 1) / 2);
      const y = Math.abs(row - (height - 1) / 2);
      const dx = Math.max(x - halfWidth + radius, 0);
      const dy = Math.max(y - halfHeight + radius, 0);
      const distance = Math.hypot(dx, dy) - radius;
      if (!(Math.abs(distance) < 0.65 && x <= halfWidth + 1 && y <= halfHeight + 1)) return '';
      const glyphRadius = [2.5, 1.2, 0.35][band];
      const cx = col * 6 + 3;
      const cy = row * 11 + 5.5;
      return `M${cx - glyphRadius},${cy}a${glyphRadius},${glyphRadius} 0 1,0 ${glyphRadius * 2},0a${glyphRadius},${glyphRadius} 0 1,0 ${-glyphRadius * 2},0`;
    }).join('')
  ).join('');
};
---

<section id="como-funciona" class="narrative" aria-labelledby="narrative-heading" data-narrative>
  <div class="narrative-sticky">
    <div class="narrative-photo-stack" aria-hidden="true"></div>
    <div class="narrative-copy-stack">
      {steps.map((step, index) => (
        <article class="narrative-step" id={`narrative-step-${index + 1}`} data-step={index}>
          <div class="fallback-photo" aria-hidden="true">
            <div class:list={['narrative-photo', { 'entry-photo': index === 0, 'exit-photo': index === 3 }]} data-photo={index}>
              <Picture src={step.photo} formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 740, 1122]} sizes="(max-width: 999px) 100vw, 52vw" alt="" loading="lazy" />
            </div>
          </div>
          <div class="step-inner shell">
            <div class="step-copy">
              {index === 0 && <h2 id="narrative-heading">Entérate de lo que pasa en tu camino antes de salir.</h2>}
              <nav class="narrative-stepper" aria-label="Pasos de cómo funciona">
                {steps.map((item, target) => (
                  <a href={`#narrative-step-${target + 1}`} data-go-step={target} aria-label={`Paso ${target + 1}: ${item.label}`} aria-current={index === target ? 'step' : undefined}>
                    <span class="step-number">{String(target + 1).padStart(2, '0')}</span>
                    {index === target && <span>{item.label}</span>}
                  </a>
                ))}
              </nav>
              <h3>
                <span class="desktop-copy">{step.title}</span>
                <span class="mobile-copy">{step.mobileTitle}</span>
              </h3>
              <p class="step-description">
                <span class="desktop-copy">{step.body}</span>
                <span class="mobile-copy">{step.mobileBody}</span>
              </p>
            </div>
            <div class="fallback-phone"><PhoneFrame screen={step.screen} alt={step.alt} /></div>
          </div>
        </article>
      ))}
    </div>
    <div class="narrative-phone-stage" hidden>
      {[0, 1, 2].map(band => <svg class:list={['narrative-halo', `halo-${band + 1}`]} width="456" height="814" viewBox="0 0 456 814" aria-hidden="true"><path d={halo(band)} fill="none" stroke="currentColor" stroke-width="0.6" /></svg>)}
    </div>
  </div>
  <div class="narrative-track" aria-hidden="true" hidden>
    {steps.map((_, index) => <div class="narrative-marker" data-marker={index} style={`--step-index: ${index}`}></div>)}
  </div>
</section>

<script>
  const narrative = document.querySelector<HTMLElement>('[data-narrative]');
  if (narrative) {
    const panels = [...narrative.querySelectorAll<HTMLElement>('.narrative-step')];
    const phoneStage = narrative.querySelector<HTMLElement>('.narrative-phone-stage')!;
    const photoStack = narrative.querySelector<HTMLElement>('.narrative-photo-stack')!;
    const track = narrative.querySelector<HTMLElement>('.narrative-track')!;
    const markers = [...track.querySelectorAll<HTMLElement>('[data-marker]')];
    const photos = [...narrative.querySelectorAll<HTMLElement>('[data-photo]')];
    const photoHomes = photos.map(photo => photo.parentElement!);
    const screens = panels.map(panel => panel.querySelector<HTMLImageElement>('.fallback-phone img')!);
    const screenHomes = screens.map(screen => screen.parentElement!);
    const firstFrame = panels[0].querySelector<HTMLElement>('.phone-preview')!;
    const firstFrameHome = firstFrame.parentElement!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = -1;
    let frameRequest = 0;
    let resizeRequest = 0;

    const setActive = (index: number) => {
      if (index === active) return;
      active = index;
      narrative.dataset.activeStep = String(index);
      panels.forEach((panel, item) => {
        const current = item === index;
        panel.dataset.current = String(current);
        panel.setAttribute('aria-hidden', String(!current));
        panel.inert = !current;
        photos[item].dataset.current = String(current);
        screens[item].dataset.current = String(current);
        screens[item].setAttribute('aria-hidden', String(!current));
      });
    };

    const updateFromScroll = () => {
      frameRequest = 0;
      if (narrative.dataset.enhanced !== 'true') return;
      const bounds = narrative.getBoundingClientRect();
      const stageHeight = phoneStage.parentElement!.getBoundingClientRect().height;
      const segment = Math.max((bounds.height - stageHeight) / panels.length, 1);
      setActive(Math.max(0, Math.min(panels.length - 1, Math.floor((-bounds.top + 1) / segment))));
    };

    const requestScrollUpdate = () => {
      if (!frameRequest && narrative.dataset.enhanced === 'true') {
        frameRequest = window.requestAnimationFrame(updateFromScroll);
      }
    };

    const restoreStack = () => {
      narrative.removeAttribute('data-enhanced');
      narrative.removeAttribute('data-active-step');
      narrative.style.removeProperty('--narrative-stage-height');
      narrative.style.removeProperty('--narrative-phone-top');
      screens.forEach((screen, index) => {
        screenHomes[index].append(screen);
        screen.removeAttribute('aria-hidden');
        screen.removeAttribute('data-current');
      });
      firstFrameHome.append(firstFrame);
      photos.forEach((photo, index) => { photoHomes[index].append(photo); photo.removeAttribute('data-current'); });
      panels.forEach(panel => { panel.removeAttribute('aria-hidden'); panel.removeAttribute('data-current'); panel.inert = false; });
      phoneStage.hidden = true;
      track.hidden = true;
      active = -1;
    };

    const configure = () => {
      resizeRequest = 0;
      restoreStack();
      const mobile = window.matchMedia('(max-width: 999px)').matches;
      const maxCopyHeight = Math.max(...panels.map(panel => panel.querySelector<HTMLElement>('.step-copy')!.getBoundingClientRect().height));
      const phoneHeight = firstFrame.getBoundingClientRect().height;
      const phoneTop = 64 + maxCopyHeight + 44;
      const requiredHeight = mobile ? phoneTop + phoneHeight + 56 : Math.max(phoneHeight + 160, maxCopyHeight + 160);
      // A pinned stage must fit the viewport; otherwise the complete storyboard remains scrollable.
      if (window.innerHeight < requiredHeight) return;
      photos.forEach(photo => photoStack.append(photo));
      phoneStage.append(firstFrame);
      screens.forEach(screen => screenHomes[0].append(screen));
      phoneStage.hidden = false;
      track.hidden = false;
      narrative.style.setProperty('--narrative-stage-height', `${window.innerHeight}px`);
      narrative.style.setProperty('--narrative-phone-top', `${phoneTop}px`);
      narrative.dataset.enhanced = 'true';
      updateFromScroll();
    };

    narrative.querySelectorAll<HTMLAnchorElement>('[data-go-step]').forEach(link => {
      link.addEventListener('click', event => {
        if (narrative.dataset.enhanced !== 'true') return;
        event.preventDefault();
        const index = Number(link.dataset.goStep);
        const keyboard = event.detail === 0;
        narrative.classList.toggle('instant-step', keyboard);
        markers[index].scrollIntoView({ behavior: reduceMotion.matches || keyboard ? 'auto' : 'smooth', block: 'start' });
        if (keyboard) {
          setActive(index);
          panels[index].querySelector<HTMLAnchorElement>(`[data-go-step="${index}"]`)?.focus({ preventScroll: true });
        }
        requestScrollUpdate();
      });
    });
    window.addEventListener('scroll', requestScrollUpdate, { passive: true });
    window.addEventListener('wheel', () => narrative.classList.remove('instant-step'), { passive: true });
    window.addEventListener('touchstart', () => narrative.classList.remove('instant-step'), { passive: true });
    window.addEventListener('resize', () => {
      if (resizeRequest) window.cancelAnimationFrame(resizeRequest);
      resizeRequest = window.requestAnimationFrame(configure);
    }, { passive: true });
    const observer = new IntersectionObserver(entries => {
      narrative.dataset.inView = String(entries.some(entry => entry.isIntersecting));
    });
    observer.observe(narrative);
    configure();
    document.fonts.ready.then(configure);
  }
</script>

<style>
.narrative { position: relative; background: var(--color-bg-night); }
.narrative-step { position: relative; isolation: isolate; }
.step-inner { display: grid; grid-template-columns: 26rem 20rem minmax(0, 1fr); gap: 3.5rem; align-items: center; min-height: 53.75rem; padding-block: 6.25rem; }
.step-copy { min-width: 0; }
.step-copy h2 { margin-bottom: 1.75rem; font-size: 3.25rem; line-height: 1.1; }
.step-copy h3 { font-size: 2.25rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; margin-block: 1.75rem; }
.step-description { font-size: 1.25rem; line-height: 1.5; }
.narrative-stepper { display: flex; align-items: center; gap: 0.5rem; width: max-content; max-width: 100%; }
.narrative-stepper a { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 0.5rem; min-width: 2.75rem; height: 2.75rem; padding-inline: 0.75rem; border: 1px solid var(--color-line-subtle); border-radius: var(--radius-full); color: var(--color-text-secondary); background: var(--color-bg-raised); font-size: 0.875rem; }
.narrative-stepper a[aria-current] { padding-inline: 1rem; background: var(--color-accent-trust); border-color: var(--color-accent-trust); color: var(--color-bg-night); font-weight: 700; }
.step-number { font-family: var(--font-mono); }
.fallback-photo { position: absolute; inset: 0 0 0 auto; width: 51.4%; z-index: -1; }
.narrative-photo { position: absolute; inset: 0; }
.narrative-photo :global(picture), .narrative-photo :global(img) { display: block; width: 100%; height: 100%; }
.narrative-photo :global(img) { object-fit: cover; filter: saturate(0.8); }
.narrative-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--color-bg-night), rgb(7 20 38 / 80%) 20%, rgb(7 20 38 / 45%) 36%, rgb(7 20 38 / 28%)); }
.narrative-photo::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
.entry-photo::before { background: linear-gradient(180deg, var(--color-bg-night), rgb(7 20 38 / 62%) 8%, rgb(7 20 38 / 25%) 16%, transparent 26%); }
.exit-photo::before { background: linear-gradient(0deg, var(--color-bg-night), rgb(7 20 38 / 62%) 8%, rgb(7 20 38 / 25%) 16%, transparent 26%); }
.fallback-phone { grid-column: 2; }
.fallback-phone :global(.phone) { border: 1.5px solid rgb(143 211 255 / 45%); border-radius: 3.25rem; background: #030a14; box-shadow: 0 0 72px rgb(143 211 255 / 16%); }
.fallback-phone :global(.phone img) { border-radius: 2.625rem; }
.narrative-phone-stage[hidden], .narrative-track[hidden] { display: none; }
.narrative-photo-stack { position: absolute; inset: 0 0 0 auto; width: 51.4%; pointer-events: none; }
.narrative-halo { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); margin: 0; color: var(--color-accent-glow); font: 10px / 11px monospace; white-space: pre; pointer-events: none; opacity: 0.5; animation: halo-wave 3.6s ease-in-out infinite; animation-play-state: paused; }
.halo-1 { animation-delay: 0s; opacity: 0.8; }
.halo-2 { animation-delay: 0.6s; }
.halo-3 { animation-delay: 1.2s; color: var(--color-accent-trust); }
.narrative[data-in-view='true'] .narrative-halo { animation-play-state: running; }
@keyframes halo-wave { 0%, 100% { opacity: 0.25; } 45% { opacity: 0.8; } }

.narrative[data-enhanced='true'] { height: calc(var(--narrative-stage-height) * 4); }
[data-enhanced='true'] .narrative-sticky { position: sticky; top: 0; height: var(--narrative-stage-height); overflow: clip; isolation: isolate; }
[data-enhanced='true'] .narrative-copy-stack { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
[data-enhanced='true'] .narrative-step { position: absolute; inset: 0; opacity: 0; transition: opacity 150ms cubic-bezier(0.23, 1, 0.32, 1), transform 150ms cubic-bezier(0.23, 1, 0.32, 1); transform: translateY(12px); }
[data-enhanced='true'] .narrative-step[data-current='true'] { opacity: 1; transform: translateY(0); transition-duration: 300ms; transition-delay: 150ms; }
[data-enhanced='true'] .step-inner { min-height: 100%; padding-block: 0; }
[data-enhanced='true'] .step-copy { pointer-events: auto; }
[data-enhanced='true'] .fallback-phone, [data-enhanced='true'] .fallback-photo { display: none; }
[data-enhanced='true'] .narrative-photo { opacity: 0; transition: opacity 600ms cubic-bezier(0.23, 1, 0.32, 1); }
[data-enhanced='true'] .narrative-photo[data-current='true'] { opacity: 1; }
.narrative-phone-stage { position: absolute; z-index: 3; top: 50%; left: max(4rem, calc((100% - 82rem) / 2)); margin-left: 29.5rem; transform: translateY(-50%); }
.narrative-phone-stage :global(.phone-preview) { position: relative; }
.narrative-phone-stage :global(.phone) { position: relative; width: 20rem; height: 41.25rem; padding: 0; border: 1.5px solid rgb(143 211 255 / 45%); border-radius: 3.25rem; background: #030a14; box-shadow: 0 0 72px rgb(143 211 255 / 16%); }
.narrative-phone-stage :global(.phone img) { position: absolute; inset: 0.65625rem; width: calc(100% - 1.3125rem); height: calc(100% - 1.3125rem); border-radius: 2.625rem; opacity: 0; transition: opacity 350ms cubic-bezier(0.23, 1, 0.32, 1); }
.narrative-phone-stage :global(.phone img[data-current='true']) { opacity: 1; }
.narrative-marker { position: absolute; inset-inline: 0; top: calc(var(--step-index) * var(--narrative-stage-height) * 0.75); height: 1px; scroll-margin-block-start: -6rem; }
.instant-step .narrative-step, .instant-step .narrative-photo, .instant-step :global(.phone img) { transition: none; }

@media (max-width: 999px) {
  .step-inner { display: flex; flex-direction: column; align-items: stretch; width: calc(100% - 2.5rem); min-height: 0; gap: 2.75rem; padding-block: 4rem 4.5rem; }
  .step-copy h2 { font-size: 2rem; margin-bottom: 1.25rem; }
  .step-copy h3 { font-size: 1.625rem; line-height: 1.2; margin-block: 1.75rem 0.75rem; }
  .step-description { font-size: 1rem; }
  .step-copy .desktop-copy { display: none; }
  .step-copy .mobile-copy { display: block; }
  .fallback-photo, .narrative-photo-stack { width: 100%; }
  .narrative-photo::after { background: linear-gradient(180deg, rgb(7 20 38 / 96%), rgb(7 20 38 / 92%) 17%, rgb(7 20 38 / 70%) 38%, rgb(7 20 38 / 25%) 62%, rgb(7 20 38 / 35%)); }
  .fallback-phone { align-self: center; }
  .fallback-phone :global(.phone-preview) { width: 14.375rem; }
  .fallback-phone :global(.phone) { border-radius: 2.34rem; }
  .fallback-phone :global(.phone img) { border-radius: 1.89rem; }
  .narrative-halo { display: none; }
  [data-enhanced='true'] .step-inner { padding-top: 4rem; }
  .narrative-phone-stage { top: var(--narrative-phone-top); left: 50%; margin-left: 0; transform: translateX(-50%); }
  .narrative-phone-stage :global(.phone) { width: 14.375rem; height: 29.6875rem; border-radius: 2.34rem; }
  .narrative-phone-stage :global(.phone img) { inset: 0.46875rem; width: calc(100% - 0.9375rem); height: calc(100% - 0.9375rem); border-radius: 1.89rem; }
  .narrative-marker { scroll-margin-block-start: -5rem; }
}
@media (prefers-reduced-motion: reduce) {
  .narrative-halo { animation: none; }
  [data-enhanced='true'] .narrative-step { transform: none; transition: none; }
  [data-enhanced='true'] .narrative-photo, .narrative-phone-stage :global(.phone img) { transition: none; }
}
</style>
