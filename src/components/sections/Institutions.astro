---
import { Picture } from 'astro:assets';
import Container from '../ui/Container.astro';
import Badge from '../ui/Badge.astro';
import GlyphField from '../ui/GlyphField.astro';
import cityPhoto from '../../assets/landing/photos/instituciones-ciudad-noche.png';
import districtMap from '../../assets/landing/svg/desktop-instituciones-MapDistrito.svg';
import mobileDistrictMap from '../../assets/landing/svg/mobile-instituciones-MapDistrito.svg';
const figures = [
  ['Reportes validados', '128'], ['Zonas en observación', '6'], ['Hora con más reportes', '17:00'],
];
// Opacities and highlighted hours are copied from the approved example panel.
const hourlyActivity = [0.35, 0.24, 0.24, 0.35, 0.55, 0.76, 0.65, 0.55, 0.65, 0.85, 1, 0.95, 0.8, 0.65, 0.45, 0.35];
const legend = [['low', 'Actividad baja'], ['recent', 'Reportes recientes'], ['high', 'Riesgo alto']];
---
<section id="instituciones" class="institutions" aria-labelledby="institutions-heading">
  <div class="city-backdrop" aria-hidden="true"><Picture src={cityPhoto} formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 768, 1440]} sizes="100vw" width={1440} height={960} alt="" loading="lazy" /></div>
  <GlyphField variant="texture" />
  <Container class="institutions-grid">
    <div class="institutions-copy">
      <h2 id="institutions-heading">Qué pasa en cada zona y a qué hora.</h2>
      <div><h3>Para municipalidades</h3><p>Reportes validados y agregados por zona y por hora, para decidir dónde poner luz, serenazgo o una patrulla. Nunca con datos personales.</p></div>
      <div><h3>Para empresas</h3><p>Un mapa de la zona de tu local o de las rutas de tu equipo, para planificar turnos y traslados con información del día.</p></div>
      <!-- No contact destination has been approved; this is not a live control. -->
      <span class="contact-label">Conversemos</span>
    </div>
    <div class="district-preview" data-ui aria-labelledby="district-heading">
      <div class="map-area">
        <picture class="district-map" aria-hidden="true"><source media="(max-width: 767px)" srcset={mobileDistrictMap.src} /><img src={districtMap.src} width="744" height="691" alt="" loading="lazy" /></picture>
        <div class="map-scrim" aria-hidden="true"></div>
        <div class="district-header"><div><h3 id="district-heading">Panel de zona</h3><p>Distrito de ejemplo · últimos 7 días</p></div></div>
        <div class="example-badge"><Badge variant="Demo">Vista previa · cifras de ejemplo</Badge></div>
        <div class="pin recent"><span class="pin-dot" aria-hidden="true"></span><div><p>Reportes recientes</p><span>17 en los últimos 7 días</span></div></div>
        <div class="pin high"><span class="pin-dot" aria-hidden="true"></span><div><p>Zona en observación</p><span>42 reportes validados</span></div></div>
      </div>
      <div class="map-legend desktop-legend" aria-hidden="true">{legend.map(([tone, label]) => <span class={tone}><i></i>{label}</span>)}</div>
      <div class="figures-card">
        <ul class="map-legend mobile-legend">{legend.map(([tone, label]) => <li class={tone}><i aria-hidden="true"></i>{label}</li>)}</ul>
        <dl class="district-figures">{figures.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
        <div class="hourly-activity">
          <h4>Reportes por hora</h4>
          <div class="heat-strip" aria-hidden="true">{hourlyActivity.map((opacity, index) => <span class:list={[index >= 10 && index <= 12 ? 'recent' : 'low']} style={`opacity:${opacity}`}></span>)}</div>
          <div class="hour-labels" aria-hidden="true">{['6 h', '9 h', '12 h', '15 h', '18 h', '21 h'].map(label => <span>{label}</span>)}</div>
        </div>
        <p class="data-note">Datos agregados por zona y hora. Nunca muestra quién reportó.</p>
      </div>
    </div>
  </Container>
</section>
<style>
.institutions { position: relative; overflow: clip; padding-block: 7.75rem 7.625rem; background: var(--color-bg-surface); }
.city-backdrop { position: absolute; inset: 0; pointer-events: none; }
.city-backdrop :global(picture), .city-backdrop :global(img) { width: 100%; height: 100%; }
.city-backdrop :global(img) { object-fit: cover; }
.city-backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--color-bg-surface) 0%, rgb(13 31 54 / 94%) 28%, rgb(13 31 54 / 62%) 50%, rgb(13 31 54 / 42%) 100%), linear-gradient(180deg, var(--color-bg-surface), rgb(13 31 54 / 62%) 8%, rgb(13 31 54 / 25%) 16%, transparent 26%, transparent 74%, rgb(13 31 54 / 25%) 84%, rgb(13 31 54 / 62%) 92%, var(--color-bg-surface)); }
.institutions :global(.institutions-grid) { position: relative; display: grid; grid-template-columns: minmax(0,400fr) minmax(0,744fr); gap: clamp(3rem,11.7vw,10.5rem); align-items: start; }
.institutions-copy { padding-top: 2.1875rem; display: flex; flex-direction: column; align-items: flex-start; gap: 3rem; }
.institutions-copy h2 { font-size: clamp(1.875rem, 1.2rem + 2vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; }
.institutions-copy h3 { font-size: 1.5rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
.institutions-copy p { margin-top: 0.75rem; font-size: 1.125rem; line-height: 1.5; max-width: 23.75rem; }
.contact-label { display: inline-flex; padding: 0.75rem 1.5rem; border-radius: var(--radius-full); background: var(--color-accent-trust); color: var(--color-bg-night); font-size: 0.9375rem; font-weight: 700; line-height: 1.2; }
.district-preview { position: relative; min-width: 0; min-height: 43.1875rem; border: 1px solid var(--color-line-subtle); border-radius: var(--radius-lg); background: var(--color-bg-night); overflow: hidden; }
.map-area { position: absolute; inset: 0; overflow: hidden; }
.district-map { position: absolute; inset: 0; }
.district-map img { width: 100%; height: 100%; max-width: none; object-fit: cover; }
.map-scrim { position: absolute; inset: 0 0 auto; height: 9.375rem; background: linear-gradient(180deg, rgb(7 20 38 / 92%), rgb(7 20 38 / 60%) 55%, transparent); }
.district-header { position: absolute; top: 1.5625rem; left: 1.6875rem; right: 1.6875rem; }
.district-header h3 { font-size: 1.25rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
.district-header p { font-size: 0.875rem; margin-top: 0.25rem; color: var(--color-text-secondary); line-height: 1.5; }
.example-badge { position: absolute; top: 2.25rem; right: 1.6875rem; }
.example-badge :global(.badge) { background: var(--color-bg-raised); border: 0; color: var(--color-text-secondary); }
.pin { position: absolute; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border: 1px solid var(--color-line-subtle); border-radius: var(--radius-md); background: var(--color-bg-raised); }
.pin p { font-size: 0.8125rem; line-height: 1.2; font-weight: 600; }
.pin span:not(.pin-dot) { display: block; margin-top: 0.125rem; font-size: 0.75rem; line-height: 1.5; color: var(--color-text-secondary); }
.pin-dot { width: 0.625rem; height: 0.625rem; border-radius: 50%; flex-shrink: 0; }
.pin.recent { top: 11.8125rem; left: 31.6%; }
.pin.high { top: 9.1875rem; right: 0.8125rem; }
.recent .pin-dot, .heat-strip .recent { background: var(--color-alert-amber); }
.high .pin-dot { background: var(--color-risk-coral); }
.map-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 0.375rem 1.25rem; padding: 0; margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.5; list-style: none; }
.map-legend > :is(span,li) { display: inline-flex; align-items: center; gap: 0.5rem; }
.map-legend i { width: 0.5rem; height: 0.5rem; flex-shrink: 0; border-radius: 50%; }
.map-legend .low i, .heat-strip .low { background: var(--color-accent-trust); }
.map-legend .recent i { background: var(--color-alert-amber); }
.map-legend .high i { background: var(--color-risk-coral); }
.desktop-legend { position: absolute; top: 22.5625rem; left: 1.6875rem; padding: 0.4375rem 0.875rem; border: 1px solid var(--color-line-subtle); border-radius: var(--radius-full); background: var(--color-bg-night); }
.mobile-legend { display: none; }
.figures-card { position: relative; margin: 25.75rem 1.1875rem 1.1875rem; padding: 1.125rem 1.375rem; background: var(--color-bg-surface); border: 1px solid var(--color-line-subtle); border-radius: 1.125rem; }
.district-figures { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0.75rem; margin: 0; }
.district-figures dt { color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.5; }
.district-figures dd { margin: 0.25rem 0 0; font-size: 1.875rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.02em; }
.hourly-activity { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-line-subtle); }
.hourly-activity h4 { margin: 0; font-size: 0.9375rem; font-weight: 700; line-height: 1.2; }
.heat-strip { display: flex; gap: 0.25rem; height: 1.625rem; margin-top: 0.75rem; }
.heat-strip span { flex: 1; min-width: 0; border-radius: 0.375rem; }
.hour-labels { display: flex; justify-content: space-between; gap: 0.25rem; margin-top: 0.75rem; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.5; }
.data-note { margin-top: 1rem; font-size: 0.875rem; line-height: 1.5; color: var(--color-text-secondary); }
@media (max-width: 1200px) and (min-width: 768px) {
  .institutions :global(.institutions-grid) { gap: 2rem; grid-template-columns: minmax(0,1fr) minmax(0,1.45fr); }
  .example-badge { top: 5rem; left: 1.6875rem; right: auto; }
  .district-figures dt { font-size: 0.75rem; }
  .desktop-legend { gap: 0.375rem 0.75rem; left: 1rem; right: 1rem; font-size: 0.75rem; }
}
@media (max-width: 767px) {
  .institutions { padding-block: 6rem; }
  .city-backdrop { bottom: auto; height: 40rem; }
  .city-backdrop::after { background: linear-gradient(180deg, var(--color-bg-surface), rgb(13 31 54 / 62%) 20%, rgb(13 31 54 / 76%) 60%, var(--color-bg-surface)); }
  .institutions :global(.institutions-grid) { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
  .institutions-copy { gap: 1.5rem; padding-top: 0; }
  .institutions-copy h2 { font-size: 1.875rem; }
  .institutions-copy h3 { font-size: 1.25rem; }
  .institutions-copy p { font-size: 1rem; margin-top: 0.375rem; max-width: none; }
  .contact-label { padding-inline: 1.375rem; }
  .district-preview { min-height: 0; }
  .map-area { position: relative; height: 19rem; }
  .district-map { top: -0.625rem; left: -3.875rem; right: auto; bottom: auto; width: 27.9rem; height: 25.9125rem; }
  .district-map img { width: 27.9rem; height: 25.9125rem; }
  .map-scrim { height: 6.875rem; background: linear-gradient(180deg, rgb(7 20 38 / 95%), rgb(7 20 38 / 70%) 55%, transparent); }
  .district-header { top: 1.125rem; left: 1.25rem; right: 1.25rem; }
  .district-header h3 { font-size: 1.125rem; }
  .district-header p { font-size: 0.8125rem; margin-top: 0.125rem; line-height: 1.4; }
  .pin.recent { top: 5.25rem; left: 0.75rem; }
  .pin.high { top: 11.875rem; left: auto; right: 0.75rem; }
  .example-badge { top: auto; bottom: 0.75rem; right: auto; left: 0.75rem; }
  .example-badge :global(.badge) { background: var(--color-bg-night); border: 1px solid var(--color-line-subtle); }
  .desktop-legend { display: none; }
  .mobile-legend { display: flex; gap: 0.375rem 1rem; margin-bottom: 1rem; }
  .figures-card { margin: 0; padding: 1.125rem 1.25rem 1.25rem; border: 0; border-radius: 0; }
  .district-figures { align-items: end; }
  .district-figures dt { font-size: 0.75rem; }
  .district-figures dd { font-size: 1.625rem; }
  .heat-strip { gap: 0.1875rem; }
  .data-note { font-size: 0.8125rem; }
}
</style>
