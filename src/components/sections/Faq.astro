---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import questions from '../../data/faq.json';
// Unapproved answers remain unpublished rather than becoming empty controls.
const publishedQuestions = questions.filter(question => question.answer !== null);
---
<Section id="preguntas" class="faq-section" labelledby="faq-heading">
  <Container>
    <div class="faq-layout">
      <div class="faq-heading"><h2 id="faq-heading">Lo que quizá te estás preguntando.</h2></div>
      <div class="faq-list">
        {publishedQuestions.map((question, index) => (
          <details open={index === 0}>
            <summary>
              <span class="question-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span>{question.question}</span>
              <span class="question-toggle" aria-hidden="true"></span>
            </summary>
            <p class="answer">{question.answer}</p>
          </details>
        ))}
      </div>
      <aside class="emergency-note"><p>En una emergencia, llama al 105 (Policía Nacional del Perú). SafeMap no reemplaza a los servicios de emergencia.</p></aside>
    </div>
  </Container>
</Section>
<style>
  :global(.faq-section) { padding-block: 8.75rem; }
  .faq-layout { display: grid; grid-template-columns: minmax(0, 432fr) minmax(0, 872fr); grid-template-rows: auto 1fr; gap: 1.5rem 0.5rem; }
  .faq-heading { grid-column: 1; grid-row: 1; }
  #faq-heading { max-inline-size: 25.5rem; font-size: clamp(2rem, 1.3rem + 2vw, 3rem); }
  .faq-list { grid-column: 2; grid-row: 1 / span 2; min-inline-size: 0; }
  details { border-top: 1px solid var(--color-line-subtle); }
  details:last-child { border-bottom: 1px solid var(--color-line-subtle); }
  summary { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr) 1rem; gap: 1.25rem; align-items: start; padding-block: 1.75rem; list-style: none; font-size: 1.5rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  summary::-webkit-details-marker { display: none; }
  .question-number { padding-top: 0.40625rem; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.3; letter-spacing: 0; }
  details[open] .question-number { color: var(--color-accent-glow); }
  .question-toggle { position: relative; display: block; inline-size: 1rem; block-size: 1rem; margin-top: 0.46875rem; }
  .question-toggle::before, .question-toggle::after { content: ''; position: absolute; background: currentColor; }
  .question-toggle::before { inset: calc(50% - 1.5px) 0 auto; block-size: 3px; }
  .question-toggle::after { inset: 0 auto 0 calc(50% - 1.5px); inline-size: 3px; }
  details[open] .question-toggle::after { display: none; }
  details[open] summary { padding-bottom: 0.875rem; }
  .answer { max-inline-size: 40rem; margin-inline-start: 3rem; margin-bottom: 1.75rem; font-size: 1.125rem; line-height: 1.5; color: var(--color-text-secondary); }
  .emergency-note { grid-column: 1; grid-row: 2; align-self: start; max-inline-size: 24.5rem; margin-right: 2.5rem; padding: 1.25rem 1.75rem; border: 1px solid var(--color-alert-amber); border-radius: 1.25rem; background: var(--color-bg-surface); }
  .emergency-note p { font-size: 1.0625rem; line-height: 1.2; font-weight: 700; }
  @media (max-width: 767px) {
    :global(.faq-section) { padding-block: 6rem; }
    .faq-layout { grid-template-columns: 1fr; gap: 2rem; }
    .faq-heading, .faq-list, .emergency-note { grid-column: auto; grid-row: auto; }
    #faq-heading { font-size: 2rem; }
    summary { grid-template-columns: 1rem minmax(0, 1fr) 1rem; gap: 0.75rem; padding-block: 1.25rem; font-size: 1.125rem; letter-spacing: 0; }
    .question-number { padding-top: 0.1875rem; font-size: 0.8125rem; }
    .question-toggle { margin-top: 0.25rem; }
    details[open] summary { padding-bottom: 0.75rem; }
    .answer { margin-inline-start: 1.75rem; margin-bottom: 1.25rem; font-size: 1rem; }
    .emergency-note { max-inline-size: none; margin: 0; padding: 1rem 1.25rem; border-radius: var(--radius-md); }
    .emergency-note p { font-size: 0.9375rem; }
  }
</style>
