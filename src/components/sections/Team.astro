---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import piero from '../../assets/landing/team/piero-espada.png';
import mariana from '../../assets/landing/team/mariana-morocho.png';
import fabrizio from '../../assets/landing/team/fabrizio-santi.png';
import mauricio from '../../assets/landing/team/mauricio-teran.png';
import jahat from '../../assets/landing/team/jahat-trinidad.png';
const members = [
  { name: 'Piero Espada', role: 'Arquitectura y pruebas', portrait: piero },
  { name: 'Mariana Morocho', role: 'Calidad y riesgos', portrait: mariana },
  { name: 'Fabrizio Santi', role: 'Coordinación y documentación', portrait: fabrizio },
  { name: 'Mauricio Terán', role: 'Análisis y modelado', portrait: mauricio },
  { name: 'Jahat Trinidad', role: 'Producto y experiencia', portrait: jahat },
];
---
<Section id="equipo" tone="surface" class="team-section" labelledby="team-heading">
  <Container>
    <h2 id="team-heading">Cinco estudiantes que caminan las mismas calles que tú.</h2>
    <p class="team-intro desktop-copy">Somos Vigilantix, un equipo de Ingeniería de Software de la UPC, en Lima. Hicimos SafeMap pensando en nuestros propios trayectos de todos los días.</p>
    <p class="team-intro mobile-copy">Somos Vigilantix, un equipo de Ingeniería de Software de la UPC, en Lima. Hicimos SafeMap pensando en nuestros propios trayectos.</p>
    <ul class="team-list">
      {members.map(member => (
        <li>
          <Image src={member.portrait} alt={`Retrato de ${member.name}`} width={250} height={300} widths={[250, 500]} sizes="(max-width: 767px) calc((100vw - 54px) / 2), (max-width: 1439px) calc((100vw - 190px) / 5), 250px" format="webp" fit="cover" loading="lazy" />
          <h3>{member.name}</h3>
          <p>{member.role}</p>
        </li>
      ))}
    </ul>
  </Container>
</Section>
<style>
  :global(.team-section) { padding-block: 8.75rem 7.5rem; }
  #team-heading { max-inline-size: 62.5rem; font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem); }
  .team-intro { max-inline-size: 35rem; margin-top: 1.625rem; font-size: 1.25rem; line-height: 1.5; }
  .team-list { display: flex; align-items: flex-start; justify-content: center; gap: 0.96875rem; list-style: none; padding: 0; margin: 2.625rem 0 0; }
  .team-list li { flex: 1 1 0; min-inline-size: 0; }
  .team-list :global(img) { inline-size: 100%; block-size: auto; aspect-ratio: 5 / 6; object-fit: cover; border-radius: var(--radius-lg); }
  .team-list h3 { margin-top: 2rem; font-size: 1.375rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  .team-list p { margin-top: 0.375rem; font-size: 1rem; line-height: 1.5; }
  @media (max-width: 767px) {
    :global(.team-section) { padding-block: 6rem 4rem; }
    #team-heading { font-size: 2rem; }
    .team-intro { margin-top: 1.5rem; font-size: 1rem; }
    .team-list { flex-wrap: wrap; gap: 1.75rem 0.875rem; margin-top: 1.5rem; }
    .team-list li { flex: 0 1 calc((100% - 0.875rem) / 2); }
    .team-list :global(img) { aspect-ratio: 168 / 208.091; border-radius: var(--radius-md); }
    .team-list h3 { margin-top: 0.375rem; font-size: 1rem; font-weight: 700; line-height: 1.2; letter-spacing: 0; }
    .team-list p { font-size: 0.875rem; }
  }
</style>
