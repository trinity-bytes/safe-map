---
/**
 * Hero console illustration.
 *
 * Abstract on purpose: this is the conceptual "instrument reading", not a
 * literal map. The concrete one lives in the demo section (MapPreview.astro).
 * Static SVG — no island, no runtime cost.
 */
const nodes = [
  { id: "01", x: 150, y: 145, tone: "cyan" },
  { id: "02", x: 470, y: 205, tone: "lime" },
  { id: "03", x: 300, y: 318, tone: "cyan" },
];

const tones: Record<string, string> = {
  cyan: "#5ee7e1",
  lime: "#c7f36b",
};
---

<div class="console-map">
  <svg
    class="console-art"
    viewBox="0 0 640 420"
    preserveAspectRatio="xMidYMid slice"
    role="img"
    aria-label="Ilustración conceptual: una lectura de contexto de zona con curvas de densidad, una ruta trazada y tres puntos de referencia"
  >
    <defs>
      <pattern id="hero-fine" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#203544" stroke-width="1" />
      </pattern>
      <pattern id="hero-coarse" width="100" height="100" patternUnits="userSpaceOnUse">
        <path d="M 100 0 L 0 0 0 100" fill="none" stroke="#5ee7e1" stroke-opacity="0.14" stroke-width="1" />
      </pattern>
      <pattern id="hero-dots" width="12" height="12" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" fill="#5ee7e1" fill-opacity="0.5" />
      </pattern>
      <radialGradient id="hero-hotspot" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f5c76b" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#f5c76b" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="hero-sweep" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#5ee7e1" stop-opacity="0" />
        <stop offset="100%" stop-color="#5ee7e1" stop-opacity="0.16" />
      </linearGradient>
    </defs>

    <rect width="640" height="420" fill="#0a141d" />
    <rect width="640" height="420" fill="url(#hero-fine)" opacity="0.5" />
    <rect width="640" height="420" fill="url(#hero-coarse)" />
    <circle cx="400" cy="175" r="175" fill="url(#hero-hotspot)" />

    <!-- Zone mesh -->
    <g stroke="#5ee7e1" stroke-opacity="0.22" fill="none">
      <path d="M 40 60 L 250 34 L 296 190 L 78 214 Z" fill="#5ee7e1" fill-opacity="0.035" />
      <path d="M 250 34 L 520 62 L 545 196 L 296 190 Z" />
      <path d="M 78 214 L 296 190 L 330 372 L 110 392 Z" />
      <path d="M 296 190 L 545 196 L 592 356 L 330 372 Z" />
      <path d="M 520 62 L 606 78 L 592 190 L 545 196 Z" fill="#5ee7e1" fill-opacity="0.05" />
    </g>

    <!-- Density texture over one zone -->
    <path d="M 78 214 L 296 190 L 330 372 L 110 392 Z" fill="url(#hero-dots)" opacity="0.32" />

    <!-- Density contours around the hotspot -->
    <g fill="none" stroke="#f5c76b">
      <path d="M 400 57 C 458 51 512 92 519 155 C 527 221 483 279 419 287 C 353 295 299 253 292 189 C 285 125 337 63 400 57 Z" stroke-opacity="0.12" />
      <path d="M 398 93 C 440 89 478 118 483 162 C 488 208 456 248 411 253 C 365 258 327 228 322 184 C 317 140 353 97 398 93 Z" stroke-opacity="0.2" />
      <path d="M 396 123 C 424 121 449 140 451 168 C 453 197 430 222 400 224 C 369 226 344 205 342 176 C 340 147 366 125 396 123 Z" stroke-opacity="0.32" />
      <path d="M 395 148 C 412 148 423 158 423 172 C 423 188 410 200 394 200 C 379 200 367 189 367 173 C 367 158 379 148 395 148 Z" stroke-opacity="0.5" fill="#f5c76b" fill-opacity="0.07" />
    </g>
    <text x="497" y="112" fill="#f5c76b" fill-opacity="0.75" font-size="9" letter-spacing="1.6">
      DENSIDAD ALTA
    </text>
    <path d="M 470 108 L 492 108" stroke="#f5c76b" stroke-opacity="0.4" stroke-width="1" />

    <!-- Traced route -->
    <path
      d="M 150 145 C 196 196 232 268 300 318 C 368 270 438 250 470 205"
      fill="none"
      stroke="#c7f36b"
      stroke-width="2.5"
      stroke-dasharray="12 8"
      stroke-opacity="0.8"
    />

    <!-- Reference nodes -->
    {
      nodes.map((node) => (
        <g>
          <circle cx={node.x} cy={node.y} r="10" fill="none" stroke={tones[node.tone]} stroke-opacity="0.45" />
          <circle cx={node.x} cy={node.y} r="3.5" fill={tones[node.tone]} />
          <rect
            x={node.x + 15}
            y={node.y - 9}
            width="27"
            height="18"
            fill="#071018"
            stroke={tones[node.tone]}
            stroke-opacity="0.8"
          />
          <text
            x={node.x + 28.5}
            y={node.y + 4}
            fill={tones[node.tone]}
            font-size="10"
            letter-spacing="1.2"
            text-anchor="middle"
          >
            {node.id}
          </text>
        </g>
      ))
    }

    <!-- Instrument chrome -->
    <g stroke="#5ee7e1" stroke-opacity="0.55" stroke-width="1.5" fill="none">
      <path d="M 16 40 L 16 16 L 40 16" />
      <path d="M 600 16 L 624 16 L 624 40" />
      <path d="M 624 380 L 624 404 L 600 404" />
      <path d="M 40 404 L 16 404 L 16 380" />
    </g>
    <g stroke="#5ee7e1" stroke-opacity="0.3">
      <path d="M 620 120 L 632 120 M 620 170 L 628 170 M 620 220 L 632 220 M 620 270 L 628 270 M 620 320 L 632 320" />
    </g>
    <text x="20" y="414" fill="#9db0bb" fill-opacity="0.6" font-size="9" letter-spacing="1.4">
      S 12.04 · W 77.03
    </text>

    <!-- Scan sweep -->
    <g class="console-sweep">
      <rect x="0" y="-88" width="640" height="88" fill="url(#hero-sweep)" />
      <path d="M 0 0 L 640 0" stroke="#5ee7e1" stroke-opacity="0.65" stroke-width="1" />
    </g>
  </svg>
</div>

<style>
  .console-map {
    position: relative;
    height: 390px;
    overflow: hidden;
    background: #0a141d;
  }

  .console-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .console-sweep {
    animation: console-sweep 7s linear infinite;
  }

  @keyframes console-sweep {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(508px);
    }
  }

  @media (max-width: 760px) {
    .console-map {
      height: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .console-sweep {
      animation: none;
      transform: translateY(210px);
    }
  }
</style>
