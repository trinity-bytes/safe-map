  animated?: boolean;
  /** Multiplies glyph opacity and ambient light; for sections where the field is the main visual. */
  gain?: number;
  /** CSS selector of the element the pulses and light bands radiate from; defaults to the field's centre. */
  origin?: string;
  class?: string;
}
