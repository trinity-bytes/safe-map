---
<glyph-field class:list={['glyph-field', className]} data-variant={variant} data-animated={animated ? 'true' : 'false'} data-gain={gain} data-origin={origin} aria-hidden="true">
  <canvas></canvas>
  <script is:inline type="application/json" set:html={JSON.stringify(source)}></script>
</glyph-field>
<script>
  interface EncodedLayer {
    id: string;
    name: string;
    x: number;
    y: number;
    size: number;
    lineHeight: number;
    opacity: number;
    token: string;
    characters: string[];
    packed: string;
    /** Generated layers carry their rows directly instead of a packed string. */
    lines?: string[];
    /** Ghost cells are invisible at rest and only appear while light passes over them. */
    ghost?: boolean;
  }

  interface LayerStyle { font: string; hot: string; pool: string[]; cell: number; ghost: boolean; }
  interface Ripple { x: number; y: number; start: number; speed: number; strength: number; reveal: boolean; }

  const POINTER_RADIUS = 170;
  const RING_WIDTH = 42;
  const AMBIENT_INTERVAL = 4200;

  // Cheap deterministic noise: the same glyph keeps its scrambled character for one time bucket.
  const noise = (index: number, bucket: number) => {
    let n = (Math.imul(index, 374761393) + Math.imul(bucket, 668265263)) | 0;
    n = Math.imul(n ^ (n >>> 13), 1274126177);
    return ((n ^ (n >>> 16)) >>> 0) / 4294967296;
  };

  class GlyphField extends HTMLElement {
    private canvas: HTMLCanvasElement | null = null;
    private buffer: HTMLCanvasElement | null = null;
    private views: { desktop: EncodedLayer[]; mobile: EncodedLayer[] } | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private intersectionObserver: IntersectionObserver | null = null;
    private motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    private visible = false;
    private frame = 0;
    private startup = 0;
    private previousPaint = 0;
    // Glyph positions in design units, kept so the few glyphs near a pulse or the pointer can be relit.
    private glyphX = new Float32Array(0);
    private glyphY = new Float32Array(0);
    private glyphLayer = new Uint8Array(0);
    private glyphChar: string[] = [];
    private layerStyles: LayerStyle[] = [];
    private ratio = 1;
    private scale = 1;
    private designWidth = 0;
    private designHeight = 0;
    private ripples: Ripple[] = [];
    private introPlayed = false;
    private lastAmbient = 0;
    private pointerInside = false;
    private pointerX = 0;
    private pointerY = 0;
    private lightX = 0;
    private lightY = 0;
    private energy = 0;
    private originX = 0;
    private originY = 0;

    connectedCallback() {
      this.canvas = this.querySelector('canvas');
      const data = this.querySelector('script[type="application/json"]')?.textContent;
      if (!this.canvas || !data) return;
      this.views = JSON.parse(data);
      this.buffer = document.createElement('canvas');
      this.resizeObserver = new ResizeObserver(() => this.resize());
      this.intersectionObserver = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting && entry.intersectionRatio > 0;
        if (this.visible) this.resize();
        else this.pointerInside = false;
        this.updatePlayback();
      }, { threshold: 0.001 });
      document.addEventListener('visibilitychange', this.updatePlayback);
      this.motion.addEventListener('change', this.updatePlayback);
      window.addEventListener('pointermove', this.onPointerMove, { passive: true });
      window.addEventListener('pointerdown', this.onPointerDown, { passive: true });

      // Paint the HTML title before doing any decorative canvas work.
      this.startup = requestAnimationFrame(() => {
        this.startup = requestAnimationFrame(() => {
          this.resize();
          this.resizeObserver?.observe(this);
          this.intersectionObserver?.observe(this);
          void document.fonts.load('10px "Geist Mono"').then(() => {
            if (this.isConnected) this.resize();
          });
        });
      });
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.startup);
      cancelAnimationFrame(this.frame);
      this.frame = 0;
      this.resizeObserver?.disconnect();
      this.intersectionObserver?.disconnect();
      document.removeEventListener('visibilitychange', this.updatePlayback);
      this.motion.removeEventListener('change', this.updatePlayback);
      window.removeEventListener('pointermove', this.onPointerMove);
      window.removeEventListener('pointerdown', this.onPointerDown);
      if (this.buffer) { this.buffer.width = 0; this.buffer.height = 0; }
    }

    private get ambient() { return this.dataset.animated === 'true'; }
    private get gain() { return Number(this.dataset.gain) || 1; }

    private resize() {
      if (!this.canvas || !this.buffer || !this.views) return;
      if (this.dataset.variant === 'texture' && !this.visible) return;
      const width = this.clientWidth;
      const height = this.clientHeight;
      if (!width || !height) return;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      this.canvas.width = this.buffer.width = Math.round(width * ratio);
      this.canvas.height = this.buffer.height = Math.round(height * ratio);
      const context = this.buffer.getContext('2d');
      if (!context) return;
      const mobile = window.matchMedia('(max-width: 767px)').matches;
      const scale = width / (mobile ? 390 : 1440);
      const style = getComputedStyle(this);
      this.ratio = ratio;
      this.scale = scale;
      this.designWidth = width / scale;
      this.designHeight = height / scale;
      this.originX = this.designWidth / 2;
      this.originY = this.designHeight * 0.42;
      const anchor = this.dataset.origin ? document.querySelector(this.dataset.origin) : null;
      if (anchor) {
        const field = this.getBoundingClientRect();
        const target = anchor.getBoundingClientRect();
        this.originX = (target.left + target.width / 2 - field.left) / scale;
        this.originY = (target.top + target.height / 2 - field.top) / scale;
      }
      const xs: number[] = [];
      const ys: number[] = [];
      const layerIndexes: number[] = [];
      this.glyphChar = [];
      this.layerStyles = [];
      context.setTransform(ratio * scale, 0, 0, ratio * scale, 0, 0);
      context.textBaseline = 'top';
      const layers = this.dataset.variant === 'radial' ? this.radialLayers() : mobile ? this.views.mobile : this.views.desktop;
      layers.forEach((layer, layerIndex) => {
        let text = layer.lines?.join('\n') ?? '';
        for (const run of layer.packed.matchAll(/([0-9a-z]+)([A-Z])/g)) {
          text += layer.characters[run[2].charCodeAt(0) - 65].repeat(parseInt(run[1], 36));
        }
        const font = `${layer.size}px "Geist Mono", monospace`;
        // Blue layers light up in the glow tone; amber and coral keep their meaning.
        const hotToken = layer.token === '--color-accent-trust' ? '--color-accent-glow' : layer.token;
        this.layerStyles.push({
          font,
          hot: style.getPropertyValue(hotToken).trim(),
          pool: layer.characters.filter(character => character.trim()),
          cell: layer.size * 0.6,
          ghost: Boolean(layer.ghost),
        });
        context.font = font;
        context.fillStyle = style.getPropertyValue(layer.token).trim();
        context.globalAlpha = Math.min(1, layer.opacity * this.gain);
        text.split('\n').forEach((line, row) => {
          const y = layer.y + row * layer.lineHeight;
          if (y > this.designHeight) return;
          // Figma's 242-character / 1452px lines use a fixed 6px cell.
          // Symbol fallbacks otherwise widen circle glyphs in whole-line fillText.
          [...line].forEach((character, column) => {
            if (character === ' ') return;
            const x = layer.x + column * layer.size * 0.6;
            if (!layer.ghost) context.fillText(character, x, y, layer.size * 0.6);
            if (x < -6 || x > this.designWidth) return;
            xs.push(x);
            ys.push(y);
            layerIndexes.push(layerIndex);
            this.glyphChar.push(character);
          });
        });
      });
      this.glyphX = Float32Array.from(xs);
      this.glyphY = Float32Array.from(ys);
      this.glyphLayer = Uint8Array.from(layerIndexes);
      this.paint(0);
      this.updatePlayback();
    }

    // Concentric rings on the character grid, centred on the origin: large circles close to it,
    // then smaller glyphs, plus ghost cells between rings so light can travel through the gaps.
    private radialLayers(): EncodedLayer[] {
      const tiers = [
        { until: 190, character: '○', token: '--color-accent-glow', opacity: 0.42 },
        { until: 360, character: '∘', token: '--color-accent-glow', opacity: 0.34 },
        { until: 600, character: '·', token: '--color-accent-trust', opacity: 0.34 },
        { until: 1000, character: ':', token: '--color-accent-trust', opacity: 0.2 },
      ];
      const SPACING = 30;
      const columns = Math.ceil(this.designWidth / 6);
      const rows = Math.ceil(this.designHeight / 11);
      const grids = [...tiers.map(() => [] as string[]), [] as string[]];
      for (let row = 0; row < rows; row++) {
        const line = grids.map(() => '');
        for (let column = 0; column < columns; column++) {
          const distance = Math.hypot(column * 6 + 3 - this.originX, row * 11 + 5.5 - this.originY);
          const tier = tiers.findIndex(item => distance < item.until);
          // The first ring starts clear of the origin element so it stays readable.
          const onRing = distance > 105 && Math.abs((distance % SPACING) - SPACING / 2) < 3.4;
          const ghost = !onRing && distance > 105 && tier >= 0 && (row + column) % 2 === 0;
          grids.forEach((_, index) => {
            line[index] += index === tier && onRing ? tiers[tier].character : index === tiers.length && ghost ? '·' : ' ';
          });
        }
        grids.forEach((grid, index) => grid.push(line[index]));
      }
      const base = { x: 0, y: 0, size: 10, lineHeight: 11, packed: '' };
      return [
        ...tiers.map((tier, index) => ({ ...base, id: `radial-${index}`, name: `Radial / ${index}`, opacity: tier.opacity, token: tier.token, characters: ['○', '∘', '·'], lines: grids[index] })),
        { ...base, id: 'radial-ghost', name: 'Radial / ghost', opacity: 0, token: '--color-accent-trust', characters: ['·'], lines: grids[tiers.length], ghost: true },
      ];
    }

    private toDesign(event: PointerEvent) {
      const rect = this.getBoundingClientRect();
      const inside = event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom;
      return { inside, x: (event.clientX - rect.left) / this.scale, y: (event.clientY - rect.top) / this.scale };
    }

    private onPointerMove = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse' || !this.visible) return;
      const point = this.toDesign(event);
      if (point.inside && !this.pointerInside && this.energy < 0.05) { this.lightX = point.x; this.lightY = point.y; }
      this.pointerInside = point.inside;
      this.pointerX = point.x;
      this.pointerY = point.y;
      if (point.inside && !this.frame) this.updatePlayback();
    };

    private onPointerDown = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse' || !this.visible || this.motion.matches) return;
      const point = this.toDesign(event);
      if (!point.inside) return;
      this.ripples.push({ x: point.x, y: point.y, start: performance.now(), speed: 0.5, strength: 1, reveal: false });
      if (!this.frame) this.updatePlayback();
    };

    private paint(time: number) {
      const context = this.canvas?.getContext('2d');
      if (!context || !this.canvas || !this.buffer) return;
      const reach = Math.hypot(this.designWidth, this.designHeight);
      this.ripples = this.ripples.filter(ripple => (time - ripple.start) * ripple.speed < reach + RING_WIDTH);
      const reveal = time ? this.ripples.find(ripple => ripple.reveal) : undefined;
      const unit = this.ratio * this.scale;

      context.setTransform(1, 0, 0, 1, 0, 0);
      context.globalCompositeOperation = 'source-over';
      context.clearRect(0, 0, this.canvas.width, this.canvas.height);
      context.save();
      if (reveal) {
        // The first pulse uncovers the field instead of fading it in.
        context.beginPath();
        context.arc(reveal.x * unit, reveal.y * unit, Math.max(0, (time - reveal.start) * reveal.speed) * unit, 0, Math.PI * 2);
        context.clip();
      }
      // Reuse one rasterized field; never redraw thousands of glyphs per frame.
      context.globalAlpha = time && this.ambient ? 0.97 + Math.sin(time / 4000) * 0.03 : 1;
      context.drawImage(this.buffer, 0, 0);
      context.restore();
      if (!time || (!this.ambient && !this.ripples.length && this.energy < 0.01)) return;

      // Relight only the glyphs a pulse or the pointer touches.
      context.setTransform(unit, 0, 0, unit, 0, 0);
      context.textBaseline = 'top';
      const bucket = Math.floor(time / 90);
      const pointerReach = POINTER_RADIUS * POINTER_RADIUS;
      const centerX = this.originX;
      const centerY = this.originY;
      const revealed = reveal ? (time - reveal.start) * reveal.speed : Infinity;
      const twinkle = Math.floor(time / 160);
      let currentLayer = -1;
      let style: LayerStyle | null = null;
      for (let index = 0; index < this.glyphX.length; index++) {
        const x = this.glyphX[index];
        const y = this.glyphY[index];
        let intensity = 0;
        if (this.ambient) {
          // Ambient life: slow bands travel outward from the shield and single glyphs flare at random.
          const distance = Math.hypot(x - centerX, y - centerY);
          if (distance > revealed) continue;
          const band = Math.sin(distance * 0.03 - time * 0.0024);
          if (band > 0.7) intensity = ((band - 0.7) / 0.3) * 0.5 * (1 - 0.6 * distance / reach);
          if (noise(index, twinkle) < 0.01) intensity += 0.9;
          intensity *= this.gain;
        }
        if (this.energy >= 0.01) {
          const dx = x - this.lightX;
          const dy = y - this.lightY;
          const squared = dx * dx + dy * dy;
          if (squared < pointerReach) {
            const falloff = 1 - Math.sqrt(squared) / POINTER_RADIUS;
            intensity = falloff * falloff * this.energy;
          }
        }
        for (const ripple of this.ripples) {
          const radius = (time - ripple.start) * ripple.speed;
          const dx = x - ripple.x;
          const dy = y - ripple.y;
          if (Math.abs(dx) > radius + RING_WIDTH || Math.abs(dy) > radius + RING_WIDTH) continue;
          const offset = Math.abs(Math.sqrt(dx * dx + dy * dy) - radius);
          if (offset < RING_WIDTH) intensity += (1 - offset / RING_WIDTH) * ripple.strength * (1 - radius / (reach + RING_WIDTH));
        }
        if (intensity < 0.05) continue;
        if (this.glyphLayer[index] !== currentLayer) {
          currentLayer = this.glyphLayer[index];
          style = this.layerStyles[currentLayer];
          context.font = style.font;
          context.fillStyle = style.hot;
        }
        if (!style) continue;
        let character = this.glyphChar[index];
        if (style.ghost) {
          intensity *= 0.6;
          if (intensity < 0.05) continue;
        } else if (style.pool.length > 1 && noise(index, bucket) < intensity * 0.45) {
          // Swap the glyph: erase the rasterized one, then draw a neighbour from the same alphabet.
          context.globalCompositeOperation = 'destination-out';
          context.globalAlpha = 1;
          context.fillText(character, x, y, style.cell);
          context.globalCompositeOperation = 'source-over';
          character = style.pool[Math.floor(noise(index, bucket + 7) * style.pool.length)];
        }
        context.globalAlpha = Math.min(1, intensity);
        context.fillText(character, x, y, style.cell);
      }
    }

    private tick = (time: number) => {
      this.frame = 0;
      if (!this.canAnimate()) return;
      if (this.ambient && !this.introPlayed) {
        this.introPlayed = true;
        this.lastAmbient = time;
        this.ripples.push({ x: this.originX, y: this.originY, start: time, speed: 0.85, strength: 1, reveal: true });
      } else if (this.ambient && time - this.lastAmbient > AMBIENT_INTERVAL) {
        this.lastAmbient = time;
        this.ripples.push({ x: this.originX, y: this.originY, start: time, speed: 0.3, strength: 0.75, reveal: false });
      }
      this.energy += ((this.pointerInside ? 1 : 0) - this.energy) * 0.1;
      this.lightX += (this.pointerX - this.lightX) * 0.22;
      this.lightY += (this.pointerY - this.lightY) * 0.22;
      // The ambient shimmer runs at 30fps; pulses and the pointer light need every frame.
      if (this.busy() || time - this.previousPaint >= 1000 / 30) {
        this.paint(time);
        this.previousPaint = time;
      }
      this.frame = requestAnimationFrame(this.tick);
    };

    private busy() {
      return this.pointerInside || this.energy >= 0.01 || this.ripples.length > 0;
    }

    private canAnimate() {
      return (this.ambient || this.busy()) && this.visible && !document.hidden && !this.motion.matches;
    }

    private updatePlayback = () => {
      cancelAnimationFrame(this.frame);
      this.frame = 0;
      if (this.canAnimate()) this.frame = requestAnimationFrame(this.tick);
      else if (this.motion.matches) { this.ripples = []; this.energy = 0; this.paint(0); }
    };
  }

