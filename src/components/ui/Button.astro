---
interface Props { href?: string; variant?: 'Primary' | 'Secondary' | 'Ghost'; class?: string; disabled?: boolean; type?: 'button' | 'submit'; }
const { href, variant = 'Primary', class: className, disabled = false, type = 'button' } = Astro.props;
const classes = ['button', variant.toLowerCase(), className];
---
{href && !disabled ? <a href={href} class:list={classes}><slot /></a> : <button type={type} disabled={disabled} class:list={classes}><slot /></button>}
<style>
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 2.625rem; padding: 0.625rem 1.5rem; border: 1px solid transparent; border-radius: var(--radius-full); font-size: 0.9375rem; font-weight: 700; line-height: 1.3; }
  .primary { background: var(--color-accent-trust); color: var(--color-bg-night); }
  .secondary { border-color: var(--color-line-subtle); background: var(--color-bg-raised); color: var(--color-text-primary); }
  .ghost { color: var(--color-text-primary); background: transparent; }
  .button:disabled { cursor: default; }
  @media (hover: hover) { .button:hover:not(:disabled) { filter: brightness(1.08); } }
</style>
