---
interface Props { variant?: 'Neutral' | 'Validated' | 'Alert' | 'Demo'; }
const { variant = 'Neutral' } = Astro.props;
---
<span class:list={['badge', variant.toLowerCase()]}><slot /></span>
<style>
.badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.75rem; border: 1px solid var(--color-line-subtle); border-radius: var(--radius-full); background: var(--color-bg-surface); color: var(--color-text-secondary); font-size: 0.8125rem; line-height: 1.25; }
.validated { color: var(--color-state-validated); }
.alert { color: var(--color-alert-amber); }
.demo { color: var(--color-accent-glow); }
</style>
