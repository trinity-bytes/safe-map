---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from './Badge.astro';
interface Props { screen: ImageMetadata; alt: string; class?: string; loading?: 'eager' | 'lazy'; label?: boolean; }
const { screen, alt, class: className, loading = 'lazy', label = true } = Astro.props;
---
<div class:list={['phone-preview', className]}>
  <div class="phone"><Image src={screen} alt={alt} widths={[296, 592]} sizes="(max-width: 767px) 212px, 296px" width={296} height={636} format="webp" loading={loading} /></div>
  {label && <div class="preview-label"><Badge variant="Demo">Vista previa · demo simulada</Badge></div>}
</div>
<style>
.phone-preview { width: 20rem; max-width: 100%; }
.phone { padding: 0.75rem; background: var(--color-bg-raised); border: 1px solid var(--color-line-subtle); border-radius: 2.75rem; overflow: hidden; }
.phone :global(img) { width: 100%; border-radius: 2rem; aspect-ratio: 296 / 636; }
.preview-label { margin-top: 1rem; text-align: center; }
@media (max-width: 767px) { .phone-preview { width: 14.375rem; } .phone { padding: 0.5625rem; border-radius: 2rem; } .phone :global(img) { border-radius: 1.5rem; } }
</style>
