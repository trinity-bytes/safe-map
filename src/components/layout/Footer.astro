---
import mark from '../../assets/landing/svg/mark-large.svg';
const base = import.meta.env.BASE_URL;
const groups = [
  { title: 'Producto', links: [['como-funciona', 'Cómo funciona'], ['privacidad', 'Privacidad'], ['planes', 'Planes']] },
  { title: 'Comunidad', links: [['equipo', 'Equipo'], ['preguntas', 'Preguntas'], ['instituciones', 'Para instituciones']] },
];
---
<footer class="footer">
  <div class="shell">
    <a href={base} class="footer-brand" aria-label="SafeMap, inicio"><img src={mark.src} width="178" height="214" alt="" /><span>SafeMap</span></a>
    <nav id="footer-navigation" class="footer-navigation" aria-label="Navegación del pie de página">
      {groups.map(group => <div><h2>{group.title}</h2><ul>{group.links.map(([id, text]) => <li><a href={`${base}#${id}`}>{text}</a></li>)}</ul></div>)}
      <div><h2>Contacto</h2><ul><li><span>X · @trinity-bytes</span></li><li>Lima, Perú</li></ul></div>
    </nav>
    <p class="copyright">© 2026 SafeMap · Vigilantix · Proyecto académico de Ingeniería de Software, UPC</p>
    <p class="course-credit">SI720 Diseño y Patrones de Software · Sección 4122 · 2025</p>
  </div>
</footer>
<style>
.footer { position: relative; background: var(--color-bg-surface); padding-block: 4rem 5rem; }
.footer-brand { display: flex; align-items: center; gap: 2rem; width: fit-content; }
.footer-brand img { width: clamp(3rem, 12.4vw, 11.125rem); height: auto; flex-shrink: 0; }
.footer-brand span { font-size: clamp(3.5rem, 17vw, 15rem); line-height: 1; font-weight: 600; letter-spacing: -0.04em; }
.footer-navigation { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-top: 5rem; }
.footer-navigation h2 { font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.5; letter-spacing: 0; font-weight: 700; }
.footer-navigation ul { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.75rem; }
.footer-navigation a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
.copyright { margin-top: 5rem; font-size: 0.875rem; color: var(--color-text-secondary); }
.course-credit { margin-top: 0.5rem; font-size: 0.75rem; color: var(--color-text-secondary); }
@media (max-width: 767px) { .footer { padding-block: 3.5rem 2rem; } .footer-brand { gap: 0.75rem; } .footer-brand span { font-size: clamp(3.5rem, 17vw, 8rem); } .footer-navigation { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.5rem; margin-top: 2rem; font-size: 0.875rem; } .copyright { margin-top: 2.5rem; font-size: 0.75rem; } }
</style>
